# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Never expose to the browser. Used by cron, seed import, analytics beacon.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated emails that are promoted to admin on first sign-in
ADMIN_EMAILS=you@example.com

# --- Agents (Phase 6) ---
ANTHROPIC_API_KEY=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=

# --- Email outreach (Phase 6) ---
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=

# --- Payments (Phase 7, OFF by default) ---
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FEATURED_PRICE_ID=
